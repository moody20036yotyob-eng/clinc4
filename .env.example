# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ecotrove"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=me-south-1
# AWS_S3_BUCKET=ecotrove-uploads

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@ecotrove.sa
SMTP_PASS=your-smtp-password
EMAIL_FROM="EcoTrove <noreply@ecotrove.sa>"

# Payment
PAYMENT_PROVIDER=moyasar
MOYASAR_API_KEY=
MOYASAR_PUBLISHABLE_KEY=
TAP_API_KEY=
HYPERPAY_ACCESS_TOKEN=

# WhatsApp
WHATSAPP_NUMBER=966500000000

# Portfolio Hosting
PORTFOLIO_BASE_URL=https://portfolio.ecotrove.sa
HOSTING_RENEWAL_PRICE_SAR=79

# Admin
ADMIN_EMAIL=admin@ecotrove.sa
ADMIN_INITIAL_PASSWORD=change-me-immediately

# Puppeteer / PDF
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome-stable
